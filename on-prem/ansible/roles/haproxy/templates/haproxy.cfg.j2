#=============================================================================
# HAProxy on-prem. Mesma lógica do lab:
#   :5000 ESCRITA  -> nó cujo Patroni responde 200 em /primary
#   :5001 LEITURA  -> nós cujo Patroni responde 200 em /replica (round-robin)
# Os backends são montados a partir do inventário (grupo [postgres]).
#=============================================================================

global
    maxconn 2000
    log /dev/log local0

defaults
    log     global
    mode    tcp
    retries 3
    timeout client  30m
    timeout connect 5s
    timeout server  30m
    timeout check   5s

listen stats
    mode http
    bind *:{{ haproxy_stats_port }}
    stats enable
    stats uri /
    stats refresh 5s

# ESCRITA -> primário
listen postgres_write
    bind *:{{ haproxy_write_port }}
    option httpchk OPTIONS /primary
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{% for h in groups['postgres'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ postgres_port }} maxconn 200 check port {{ patroni_api_port }}
{% endfor %}

# LEITURA -> réplicas (round-robin)
listen postgres_read
    bind *:{{ haproxy_read_port }}
    balance roundrobin
    option httpchk OPTIONS /replica
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{% for h in groups['postgres'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ postgres_port }} maxconn 200 check port {{ patroni_api_port }}
{% endfor %}
