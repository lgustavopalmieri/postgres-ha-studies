! keepalived: gerencia o VIP {{ haproxy_vip }} entre os HAProxy.
! O primeiro host do grupo é MASTER (prioridade maior); os demais, BACKUP.
! Se o MASTER cair, o VIP migra para o BACKUP automaticamente.

vrrp_script chk_haproxy {
    script "killall -0 haproxy"   # verifica se o processo haproxy está vivo
    interval 2
    weight 2
}

vrrp_instance VI_1 {
{% if inventory_hostname == groups['haproxy'][0] %}
    state MASTER
    priority 110
{% else %}
    state BACKUP
    priority 100
{% endif %}
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id 51
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ cluster_name }}vip
    }

    virtual_ipaddress {
        {{ haproxy_vip }}
    }

    track_script {
        chk_haproxy
    }
}
