[Unit]
Description=Patroni PostgreSQL HA
After=network.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart=/usr/local/bin/patroni /etc/patroni/patroni.yml
Restart=always
RestartSec=5
LimitNOFILE=65536
# Permite ao Patroni rebaixar/parar o Postgres com elegância no shutdown.
KillMode=process
TimeoutSec=60

[Install]
WantedBy=multi-user.target
